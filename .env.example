# ---------------------------------------------------------------- database (MongoDB)
# Leave empty in development: `npm run dev` starts a local MongoDB for you.
# Production: a database user with readWrite on this database only. Atlas uses TLS by default.
MONGODB_URI=
# MONGODB_URI=mongodb+srv://ind2b_app:PASSWORD@cluster0.xxxxx.mongodb.net
MONGODB_DB=ind2b

# ---------------------------------------------------------------- authentication (JWT)
# Signs every session token (HS256). Required in production: 32+ random characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# During a key rotation: put the OLD secret here for one session lifetime (12 h for staff/merchants,
# 30 days for shoppers), so tokens signed with it keep working, then remove it.
SESSION_SECRET_PREVIOUS=

# ---------------------------------------------------------------- super admin (complete control, signs in at /admin/login)
# Created (or promoted) automatically on start-up. Password: 12+ chars, upper + lower case, digit, symbol.
# Or run `npm run superadmin` instead and leave these empty.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=
# true = overwrite the password of the existing super admin on the next start (recovery). Remove afterwards.
SUPERADMIN_RESET_PASSWORD=false

# ---------------------------------------------------------------- images (Cloudinary)
# Copy "API environment variable" from the Cloudinary console (Settings → API Keys).
# Required in production unless ALLOW_LOCAL_UPLOADS=true.
CLOUDINARY_URL=
# …or the three parts separately:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ind2b
# Development without Cloudinary stores images in ./.uploads
ALLOW_LOCAL_UPLOADS=false
UPLOAD_DIR=.uploads

# ---------------------------------------------------------------- email (sign-up codes, password reset)
# gmail  = Gmail / Google Workspace with an App Password (Google Account → Security → 2-Step Verification → App passwords)
# smtp   = any SMTP server (also set SMTP_HOST and SMTP_PORT)
# Empty in development = emails (with the codes) are printed in the server log.
# Check the settings with:  npm run email:test -- --to you@example.com
EMAIL_PROVIDER=
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=IND2B
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=

# ---------------------------------------------------------------- hosting
# Stores live on <slug>.ROOT_DOMAIN. Use "localhost" in development.
ROOT_DOMAIN=localhost
APP_URL=http://localhost:3000
# Extra hostnames that serve the platform (comma separated)
APP_HOSTS=
# true when running behind a proxy / load balancer that sets X-Forwarded-For
TRUST_PROXY=false

# ---------------------------------------------------------------- demo data
# Development only. Never true in production.
SEED_DEMO_DATA=true
SHOW_DEMO_ACCOUNTS=false
